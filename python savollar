# 8.5 Binary search
def binary_search(lst, target):
    left, right = 0, len(lst) - 1
    while left <= right:
        mid = (left + right) // 2
        if lst[mid] == target:
            return mid
        elif lst[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return -1

def binary_test():
    lst = [1, 3, 5, 7, 9, 11]
    print("Indeks:", binary_search(lst, 7))

# 8.6 Bubble sort
def bubble_sort(lst):
    n = len(lst)
    for i in range(n):
        for j in range(0, n-i-1):
            if lst[j] > lst[j+1]:
                lst[j], lst[j+1] = lst[j+1], lst[j]
    return lst

def bubble_test():
    print("Tartiblangan:", bubble_sort([64, 34, 25, 12, 22, 11, 90]))

