# 6.15 Faylni shifrlovchi va deshifrlovchi dastur
def shifrla(matn, kalit=3):
    natija = ""
    for c in matn:
        if c.isalpha():
            base = ord('A') if c.isupper() else ord('a')
            natija += chr((ord(c) - base + kalit) % 26 + base)
        else:
            natija += c
    return natija

def deshifrla(matn, kalit=3):
    return shifrla(matn, -kalit)

def faylni_shifrla_deshifrla():
    kirish = input("Shifrlanadigan fayl: ")
    chiqish = input("Shifrlangan fayl nomi: ")
    kalit = int(input("Kalit (son): "))

    try:
        with open(kirish, 'r', encoding='utf-8') as f:
            matn = f.read()
        shifr_matn = shifrla(matn, kalit)
        with open(chiqish, 'w', encoding='utf-8') as f:
            f.write(shifr_matn)
        print("Fayl shifrlab yozildi!")

        deshifr_fayl = "deshifrlangan_" + kirish
        with open(deshifr_fayl, 'w', encoding='utf-8') as f:
            f.write(deshifrla(shifr_matn, kalit))
        print("Deshifrlangan nusxa ham yaratildi.")
    except FileNotFoundError:
        print("Kirish fayli topilmadi!")


