# 8.3 Sonni rim raqamiga
def arab_to_rim(n):
    qiymatlar = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    rim = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    natija = ""
    for i in range(len(qiymatlar)):
        while n >= qiymatlar[i]:
            natija += rim[i]
            n -= qiymatlar[i]
    return natija

