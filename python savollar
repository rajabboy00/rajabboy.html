# 7.14 Tic-tac-toe
def tic_tac_toe():
    board = [" "] * 9
    def chop_et():
        for i in range(0, 9, 3):
            print("|".join(board[i:i+3]))
    def golibmi():
        g = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]
        for komb in g:
            if board[komb[0]] == board[komb[1]] == board[komb[2]] != " ":
                return board[komb[0]]
        return None
    for i in range(9):
        chop_et()
        player = "X" if i % 2 == 0 else "O"
        while True:
            try:
                k = int(input(f"{player} uchun indeks (0-8): "))
                if board[k] == " ":
                    board[k] = player
                    break
                else:
                    print("Band joy!")
            except:
                print("Noto'g'ri kiritish!")
        g = golibmi()
        if g:
            chop_et()
            print(f"{g} yutdi!")
            return
    chop_et()
    print("Durrang!")

